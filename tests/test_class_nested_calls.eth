# Test nested method calls
class Math {
    def add(a, b) {
        return a + b
    }
    
    def double(x) {
        return self.add(x, x)
    }
    
    def quadruple(x) {
        return self.double(self.double(x))
    }
}

let m = new Math()
let result = m.quadruple(5)
print("Quadruple of 5:")
print(result)