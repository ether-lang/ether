# Multiple closures created with different captured values

def make_pair(x, y) {
    def f1() { return x }
    def f2() { return y }
    return [f1, f2]
}

let pair = make_pair(100, 200)
let f1 = pair[0]
let f2 = pair[1]

print("multiple closures:")
print(f1())
print(f2())

# Expected:
# multiple closures:
# 100
# 200
