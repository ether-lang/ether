# Test match result used in arithmetic
def fibonacci_like(n) {
    let result = match n {
        0 => 0,
        1 => 1,
        2 => 1,
        3 => 2,
        4 => 3,
        _ => 5
    }
    return result
}

let sum = fibonacci_like(0) + fibonacci_like(1) + fibonacci_like(4)
print("Sum:")
print(sum)

let product = fibonacci_like(3) * fibonacci_like(4)
print("Product:")
print(product)

# Expected output:
# Sum:
# 4
# Product:
# 6