# Test super method calls
class Base {
    let value
    
    fn new(v) {
        self.value = v
    }
    
    fn process() {
        print("Base processing:")
        print(self.value)
        return self.value
    }
}

class Derived extends Base {
    fn new(v) {
        super(v * 2)
    }
    
    fn process() {
        print("Derived processing first")
        let result = super.process()
        print("Derived processing after")
        return result + 10
    }
}

let obj = new Derived(5)
let final_result = obj.process()
print("Final result:")
print(final_result)