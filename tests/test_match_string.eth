# Test string matching
def greet(lang) {
    let greeting = match lang {
        "en" => "Hello",
        "es" => "Hola",
        "fr" => "Bonjour",
        "de" => "Guten Tag",
        _ => "Hi"
    }
    print(greeting)
}

greet("en")
greet("es")
greet("jp")

# Expected output:
# Hello
# Hola
# Hi