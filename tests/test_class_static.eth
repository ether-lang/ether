# Test static methods
class MathUtils {
    static def pi() {
        return 3.14159
    }
    
    static def max(a, b) {
        if a > b {
            return a
        } else {
            return b
        }
    }
}

let pi_value = MathUtils.pi()
print("PI:")
print(pi_value)

let max_value = MathUtils.max(10, 20)
print("Max of 10 and 20:")
print(max_value)