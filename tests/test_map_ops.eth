# Test map creation and operations

print("Creating map:")
let person = {
    "name": "Alice",
    "age": 30,
    "city": "Lagos"
}
print(person)

print("Accessing values:")
print(person["name"])
print(person["age"])
print(person["city"])

print("Adding new key:")
person["country"] = "Nigeria"
print(person["country"])

print("Updating value:")
person["age"] = 31
print(person["age"])

print("Using integer keys:")
let scores = {
    "1": 100,
    "2": 95,
    "3": 87
}
print(scores["1"])
print(scores["2"])

# Expected output:
# Creating map:
# {name: Alice, age: 30, city: Lagos}
# Accessing values:
# Alice
# 30
# Lagos
# Adding new key:
# Nigeria
# Updating value:
# 31
# Using integer keys:
# 100
# 95