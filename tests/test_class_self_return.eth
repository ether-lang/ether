# Test returning self for potential method chaining
class Builder {
    let x
    let y
    
    def new() {
        self.x = 0
        self.y = 0
    }
    
    def set_x(value) {
        self.x = value
        return self
    }
    
    def set_y(value) {
        self.y = value
        return self
    }
    
    def build() {
        print("Built with:")
        print(self.x)
        print(self.y)
        return self
    }
}

let b = new Builder()
b = b.set_x(10)
b = b.set_y(20)
b = b.build()
print(b)