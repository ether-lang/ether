# Test type annotations in function parameters

fn add_numbers(a: int, b: int) -> int {
    return a + b
}

fn greet(name: string) {
    print("Hello")
    print(name)
}

let sum = add_numbers(5, 3)
print("Sum:")
print(sum)

greet("Alice")

# Test with wrong type (should fail at runtime)
# Uncomment to test:
# add_numbers("5", 3)

# Expected output:
# Sum:
# 8
# Hello
# Alice