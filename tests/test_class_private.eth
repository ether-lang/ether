# Test private methods
class BankAccount {
    let balance
    
    def new(initial) {
        self.balance = initial
    }
    
    private def _validate(amount) {
        if amount > 0 {
            return true
        } else {
            return false
        }
    }
    
    def deposit(amount) {
        if self._validate(amount) {
            self.balance = self.balance + amount
            print("Deposited:")
            print(amount)
        }
    }
    
    def get_balance() {
        print("Balance:")
        print(self.balance)
    }
}

let account = new BankAccount(100)
account.deposit(50)
account.get_balance()

# This should fail if called externally:
# account._validate(10)