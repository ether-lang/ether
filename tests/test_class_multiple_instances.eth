# Test that multiple instances have independent state
class Counter {
    let count
    
    def new() {
        self.count = 0
    }
    
    def increment() {
        self.count = self.count + 1
    }
    
    def get_count() {
        print("Count:")
        print(self.count)
    }
}

let c1 = new Counter()
let c2 = new Counter()

c1.increment()
c1.increment()
c1.increment()

c2.increment()

print("Counter 1:")
c1.get_count()

print("Counter 2:")
c2.get_count()

# Expected output:
# Counter 1:
# Count:
# 3
# Counter 2:
# Count:
# 1