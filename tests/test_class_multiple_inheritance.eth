# Test multiple inheritance
class Flyer {
    def fly() {
        print("I can fly!")
    }
}

class Swimmer {
    def swim() {
        print("I can swim!")
    }
}

class Duck extends Flyer, Swimmer {
    let name
    
    def new(n) {
        self.name = n
    }
    
    def introduce() {
        print("I am a duck named")
        print(self.name)
    }
}

let donald = new Duck("Donald")
donald.introduce()
donald.fly()
donald.swim()

# Expected output:
# I am a duck named
# Donald
# I can fly!
# I can swim!