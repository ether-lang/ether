# Test methods that return values
class Calculator {
    def add(a, b) {
        return a + b
    }
    
    def multiply(a, b) {
        return a * b
    }
    
    def square(x) {
        return x * x
    }
}

let calc = new Calculator()

let sum = calc.add(5, 3)
print("5 + 3 =")
print(sum)

let product = calc.multiply(4, 7)
print("4 * 7 =")
print(product)

let squared = calc.square(9)
print("9 * 9 =")
print(squared)

# Expected output:
# 5 + 3 =
# 8
# 4 * 7 =
# 28
# 9 * 9 =
# 81