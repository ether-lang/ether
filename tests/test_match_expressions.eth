# Test match with complex expressions in cases
def calculate(op, a, b) {
    let result = match op {
        "add" => a + b,
        "sub" => a - b,
        "mul" => a * b,
        "div" => a / b,
        _ => 0
    }
    print(result)
}

calculate("add", 5, 3)
calculate("mul", 4, 7)
calculate("sub", 10, 3)
calculate("unknown", 1, 2)

# Expected output:
# 8
# 28
# 7
# 0