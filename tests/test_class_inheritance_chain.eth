# Test inheritance chain
class Animal {
    let name
    
    def new(n) {
        self.name = n
    }
    
    def eat() {
        print(self.name)
        print("is eating")
    }
}

class Mammal extends Animal {
    def feed_young() {
        print(self.name)
        print("feeds its young")
    }
}

class Dog extends Mammal {
    def bark() {
        print(self.name)
        print("says: Woof!")
    }
}

let dog = new Dog("Buddy")
dog.eat()
dog.feed_young()
dog.bark()

# Expected output:
# Buddy
# is eating
# Buddy
# feeds its young
# Buddy
# says: Woof!