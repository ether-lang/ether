# Test single inheritance
class Animal {
    let name
    
    fn new(n) {
        self.name = n
    }
    
    fn speak() {
        print("Animal speaks")
    }
    
    fn introduce() {
        print("I am")
        print(self.name)
    }
}

class Dog extends Animal {
    let breed
    
    fn new(n, b) {
        super(n)
        self.breed = b
    }
    
    fn speak() {
        print("Woof!")
    }
    
    fn show_breed() {
        print("Breed:")
        print(self.breed)
    }
}

let dog = new Dog("Buddy", "Golden Retriever")
dog.introduce()
dog.speak()
dog.show_breed()