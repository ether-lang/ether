# Test list slicing operations

let numbers = [10, 20, 30, 40, 50, 60, 70]

print("Original list:")
print(numbers)

print("Slice [1:4]:")
let slice1 = numbers[1:4]
print(slice1)

print("Slice [:3]:")
let slice2 = numbers[:3]
print(slice2)

print("Slice [4:]:")
let slice3 = numbers[4:]
print(slice3)

print("Slice [2:6]:")
let slice4 = numbers[2:6]
print(slice4)

print("Negative indices [-3:]:")
let slice5 = numbers[-3:]
print(slice5)

print("Negative indices [:-2]:")
let slice6 = numbers[:-2]
print(slice6)

# Expected output:
# Original list:
# [10, 20, 30, 40, 50, 60, 70]
# Slice [1:4]:
# [20, 30, 40]
# Slice [:3]:
# [10, 20, 30]
# Slice [4:]:
# [50, 60, 70]
# Slice [2:6]:
# [30, 40, 50, 60]
# Negative indices [-3:]:
# [50, 60, 70]
# Negative indices [:-2]:
# [10, 20, 30, 40, 50]