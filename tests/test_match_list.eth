# Test match with list patterns
def describe_list(lst) {
    let desc = match lst {
        [] => "empty",
        [42] => "singleton with 42",
        _ => "other"
    }
    print(desc)
}

describe_list([])
describe_list([42])
describe_list([1, 2, 3])

# Expected output:
# empty
# singleton with 42
# other